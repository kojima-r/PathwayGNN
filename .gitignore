__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
.idea/
.vscode/

# Prepared datasets are regenerable from raw data plus the preprocessing code.
# data_sample/raw/ is the exception that IS committed: it is the 12 KB tutorial
# corpus (see data_sample/README.md), so a fresh clone can run the pipeline.
data_sample/prepared/
data_tr/prepared/
data_cancer/prepared/
data_cdr/prepared/
# The drug-response corpus: 1.6 GB of raw inputs (hg38.2bit, the CCLP export)
# and a 9.3 GB upstream bundle, both regenerable via scripts/cdr/upstream/, and
# some raw inputs carry separate licences (COSMIC requires registration).
data_cdr/raw/
data_cdr/processed/
# The target-repositioning corpus: 21.5 GB of raw inputs (the LINCS L1000 Level 5
# GCTX matrix dominates) and the bundle built from them, both regenerable via
# scripts/tr/upstream/download_raw_data.py + `pathwaygnn-data tr-build-processed`.
data_tr/raw/
data_tr/processed/
# METIS graph partitions, regenerable from prepared/ with `pathwaygnn partition`.
# The partition files themselves match *.pt below; this also covers the manifest.
data_*/partitions/
outputs/
*.pt
*.pth
*.ckpt
events.out.tfevents.*
